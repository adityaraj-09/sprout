{
  "name": "sproutdb",
  "version": "0.1.0",
  "description": "Sprout — CoW Postgres branching client (CLI + SDK for sprout-server)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "sprout": "./bin/sprout.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "branching",
    "cow",
    "database",
    "sprout"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/adityaraj/sprout.git"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
